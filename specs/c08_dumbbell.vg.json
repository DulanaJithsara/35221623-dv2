{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging choropleth map: percentage change in animals received by each state/territory RSPCA from 2023-24 to 2024-25. Blue = fewer animals, gold = more. Source: RSPCA National Statistics 2024-25, Table 4.",
  "width": "container",
  "height": 420,
  "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-134, 0]},
  "layer": [
    {
      "data": {"url": "data/received_by_state.csv"},
      "transform": [
        {"filter": "datum.group == 'All animals'"},
        {"calculate": "(datum.received_2425 - datum.received_2324) / datum.received_2324", "as": "pct_change"},
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/aus_states.topojson",
              "format": {"type": "topojson", "feature": "states"}
            },
            "key": "properties.state"
          },
          "as": "geo"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#172A45", "strokeWidth": 1.5},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "pct_change",
          "type": "quantitative",
          "title": "Change in animals received",
          "scale": {
            "domain": [-0.35, -0.175, 0, 0.175, 0.35],
            "range": ["#2E8FB8", "#25628C", "#1E3557", "#9C7A3E", "#FFB547"],
            "interpolate": "rgb"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "labelExpr": "datum.value == 0 ? '0%' : format(datum.value, '+.0%')",
            "values": [-0.3, -0.15, 0, 0.15, 0.3],
            "gradientLength": 260,
            "titleLimit": 400
          }
        },
        "tooltip": [
          {"field": "state_name", "title": "RSPCA"},
          {"field": "received_2324", "title": "Received 2023–24", "format": ","},
          {"field": "received_2425", "title": "Received 2024–25", "format": ","},
          {"field": "pct_change", "title": "Change", "format": "+.1%"}
        ]
      }
    },
    {
      "data": {"url": "data/received_by_state.csv"},
      "transform": [
        {"filter": "datum.group == 'All animals'"},
        {"calculate": "(datum.received_2425 - datum.received_2324) / datum.received_2324", "as": "pct_change"},
        {
          "lookup": "state",
          "from": {
            "data": {"url": "data/state_centroids.csv"},
            "key": "state",
            "fields": ["lon", "lat"]
          }
        },
        {"calculate": "datum.state == 'ACT' ? +datum.lon + 2.6 : (datum.state == 'VIC' ? +datum.lon + 0.8 : +datum.lon)", "as": "lon_l"},
        {"calculate": "datum.state == 'ACT' ? +datum.lat - 0.9 : +datum.lat", "as": "lat_l"},
        {"calculate": "datum.state + ' ' + format(datum.pct_change, '+.0%')", "as": "label"}
      ],
      "encoding": {
        "longitude": {"field": "lon_l", "type": "quantitative"},
        "latitude": {"field": "lat_l", "type": "quantitative"},
        "text": {"field": "label"}
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": 700,
            "color": "#0F1B2D",
            "stroke": "#0F1B2D",
            "strokeWidth": 4,
            "strokeJoin": "round",
            "opacity": 0.75
          }
        },
        {"mark": {"type": "text", "fontSize": 13, "fontWeight": 700, "color": "#FFFFFF"}}
      ]
    }
  ]
}