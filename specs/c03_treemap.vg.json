{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap (Vega): all 77,464 animals received in 2024-25, nested by animal group then by state/territory RSPCA. Area = number of animals. Source: RSPCA National Statistics 2024-25, Table 4.",
  "width": 700,
  "height": 380,
  "padding": 0,
  "autosize": "none",
  "data": [
    {
      "name": "source",
      "url": "data/received_by_state.csv",
      "format": {
        "type": "csv",
        "parse": {
          "received_2425": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.group !== 'All animals' && datum.received_2425 > 0"
        }
      ]
    },
    {
      "name": "groupTotals",
      "source": "source",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "group"
          ],
          "fields": [
            "received_2425"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "tree",
      "source": "source",
      "transform": [
        {
          "type": "nest",
          "keys": [
            "group"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "received_2425",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 2,
          "paddingTop": 22,
          "paddingOuter": 0,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.children && datum.depth == 1"
        },
        {
          "type": "lookup",
          "from": "groupTotals",
          "key": "group",
          "fields": [
            "key"
          ],
          "values": [
            "total"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum.x1 - datum.x0"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum.y1 - datum.y0"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Dogs",
        "Cats",
        "Wildlife",
        "Other pets",
        "Livestock & horses"
      ],
      "range": [
        "#3A93E0",
        "#E26A3A",
        "#1FA982",
        "#977AE6",
        "#B88826"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#172A45"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 2"
          },
          "y": {
            "signal": "datum.y0 + 15"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0 > 150) ? datum.key + '  ' + format(datum.total, ',') : datum.key"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#E9EEF5"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 4"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "group"
          },
          "cornerRadius": {
            "value": 2
          },
          "tooltip": {
            "signal": "{'Animal group': datum.group, 'RSPCA': datum.state_name, 'Animals received': format(datum.received_2425, ','), 'Share of all 77,464': format(datum.received_2425 / 77464, '.1%')}"
          }
        },
        "update": {
          "fillOpacity": {
            "value": 0.92
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.7
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 17"
          },
          "text": {
            "signal": "(datum.w > 44 && datum.h > 22) ? datum.state : ''"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#0F1B2D"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 32"
          },
          "text": {
            "signal": "(datum.w > 56 && datum.h > 40) ? format(datum.received_2425, ',') : ''"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#0F1B2D"
          }
        }
      }
    }
  ]
}
