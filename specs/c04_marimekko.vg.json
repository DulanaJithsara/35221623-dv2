{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Marimekko (mosaic) chart: column width = number of animals in each group; segment height = share of each outcome. Source: RSPCA National Statistics 2024-25, Table 4 (outcome rows).",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/outcomes_2425.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "group",
        "outcome_family"
      ]
    },
    {
      "calculate": "indexof(['Reunited with owner','Rehomed','Released to the wild','Still in care or transferred','Other / died in care','Euthanased'], datum.outcome_family)",
      "as": "o_order"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "n",
          "as": "group_total"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "n",
          "as": "grand_total"
        }
      ]
    },
    {
      "calculate": "indexof(['Wildlife','Cats','Dogs','Other pets','Livestock & horses'], datum.group)",
      "as": "g_order"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "n",
          "as": "x_cum"
        }
      ],
      "sort": [
        {
          "field": "g_order"
        },
        {
          "field": "o_order"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "n",
          "as": "y_cum"
        }
      ],
      "groupby": [
        "group"
      ],
      "sort": [
        {
          "field": "o_order"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "x_cum",
          "as": "x_group_end"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "calculate": "(datum.x_group_end - datum.group_total) / datum.grand_total",
      "as": "x0"
    },
    {
      "calculate": "datum.x_group_end / datum.grand_total",
      "as": "x1"
    },
    {
      "calculate": "(datum.y_cum - datum.n) / datum.group_total",
      "as": "y0"
    },
    {
      "calculate": "datum.y_cum / datum.group_total",
      "as": "y1"
    },
    {
      "calculate": "datum.n / datum.group_total",
      "as": "share"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "y_mid"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#172A45",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": {
            "format": ".0%",
            "title": "Share of animals in the group",
            "tickCount": 5
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "outcome_family",
          "type": "nominal",
          "title": "What happened",
          "scale": {
            "domain": [
              "Reunited with owner",
              "Rehomed",
              "Released to the wild",
              "Still in care or transferred",
              "Other / died in care",
              "Euthanased"
            ],
            "range": [
              "#2A9D8F",
              "#7FD6CB",
              "#CDEFEA",
              "#4A6285",
              "#33496B",
              "#E8668F"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 3,
            "symbolType": "square",
            "labelLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Animal group"
          },
          {
            "field": "outcome_family",
            "title": "Outcome"
          },
          {
            "field": "n",
            "title": "Animals",
            "format": ","
          },
          {
            "field": "share",
            "title": "Share of group",
            "format": ".1%"
          },
          {
            "field": "group_total",
            "title": "Group total (outcome rows)",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.share >= 0.08 && (datum.x1 - datum.x0) > 0.05"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "format": ".0%"
        },
        "color": {
          "condition": {
            "test": "datum.outcome_family == 'Still in care or transferred' || datum.outcome_family == 'Other / died in care'",
            "value": "#E9EEF5"
          },
          "value": "#0F1B2D"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x0",
              "as": "x0"
            },
            {
              "op": "max",
              "field": "x1",
              "as": "x1"
            },
            {
              "op": "max",
              "field": "group_total",
              "as": "t"
            }
          ],
          "groupby": [
            "group"
          ]
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "xm"
        },
        {
          "calculate": "(datum.x1 - datum.x0) > 0.1 ? datum.group + ' (' + format(datum.t, ',') + ')' : datum.group",
          "as": "lab"
        },
        {
          "filter": "(datum.x1 - datum.x0) >= 0.04"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 6,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#E9EEF5",
        "limit": 140
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x0",
              "as": "x0"
            },
            {
              "op": "max",
              "field": "x1",
              "as": "x1"
            },
            {
              "op": "max",
              "field": "group_total",
              "as": "t"
            }
          ],
          "groupby": [
            "group"
          ]
        },
        {
          "filter": "(datum.x1 - datum.x0) < 0.04"
        },
        {
          "calculate": "datum.group + ' (' + format(datum.t, ',') + ')'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "align": "right",
        "dy": 24,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#9DAEC4"
      },
      "encoding": {
        "x": {
          "field": "x1",
          "type": "quantitative"
        },
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    }
  ]
}
